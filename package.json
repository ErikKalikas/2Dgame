{
  "name": "lower-tier",
  "private": true,
  "version": "0.1.0",
  "description": "Lower Tier — тёмный индустриальный рогалик с элементами bullet hell",
  "type": "module",
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "app": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win portable --x64",
    "dist:linux": "vite build && electron-builder --linux AppImage --x64"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "main": "electron/main.cjs",
  "author": "ErikKalikas",
  "build": {
    "appId": "com.erikkalikas.lowertier",
    "productName": "Lower Tier",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "portable": {
      "artifactName": "Lower-Tier-${version}-portable.exe"
    },
    "appImage": {
      "artifactName": "Lower-Tier-${version}.AppImage"
    }
  }
}
